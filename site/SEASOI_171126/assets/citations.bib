@misc{taillandierIntegratingLLMAgentBased2025a,
	title = {Integrating {LLM} in {Agent}-{Based} {Social} {Simulation}: {Opportunities} and {Challenges}},
	shorttitle = {Integrating {LLM} in {Agent}-{Based} {Social} {Simulation}},
	url = {http://arxiv.org/abs/2507.19364},
	doi = {10.48550/arXiv.2507.19364},
	abstract = {This position paper examines the use of Large Language Models (LLMs) in social simulation, analyzing both their potential and their limitations from a computational social science perspective. The first part reviews recent findings on the ability of LLMs to replicate key aspects of human cognition, including Theory of Mind reasoning and social inference, while also highlighting significant limitations such as cognitive biases, lack of true understanding, and inconsistencies in behavior. The second part surveys emerging applications of LLMs in multi-agent simulation frameworks, focusing on system architectures, scale, and validation strategies. Notable projects such as Generative Agents (Smallville) and AgentSociety are discussed in terms of their design choices, empirical grounding, and methodological innovations. Particular attention is given to the challenges of behavioral fidelity, calibration, and reproducibility in large-scale LLM-driven simulations. The final section distinguishes between contexts where LLMs, like other black-box systems, offer direct value-such as interactive simulations and serious games-and those where their use is more problematic, notably in explanatory or predictive modeling. The paper concludes by advocating for hybrid approaches that integrate LLMs into traditional agent-based modeling platforms (GAMA, Netlogo, etc), enabling modelers to combine the expressive flexibility of language-based reasoning with the transparency and analytical rigor of classical rule-based systems.},
	urldate = {2026-02-18},
	publisher = {arXiv},
	author = {Taillandier, Patrick and Zucker, Jean Daniel and Grignard, Arnaud and Gaudou, Benoit and Huynh, Nghi Quang and Drogoul, Alexis},
	month = jul,
	year = {2025},
	note = {arXiv:2507.19364 [cs]},
	keywords = {Computer Science - Artificial Intelligence, Computer Science - Multiagent Systems},
	annote = {Auto-generated summary review, based on general default instructions with specific collection instructions (including approved ancestors where applicable). Verify against the original article; this is not a human-authored review.Zopilot summary reviewzotero-copilot:v1:user:199725:XPE6H43G:A4RQMC2GLength advisory: 711 words; the preferred range is 400-650 words. The full summary is preserved without truncation.Reference advisory: the generated text omitted the DOI. The verified source DOI is supplied separately below.**Summary: Taillandier et al. (2025), "Integrating LLM in Agent-Based Social Simulation: Opportunities and Challenges"****Extraction note:** All 24 PDF pages were extracted. This is a position paper, not an empirical study. I report its claims as claims and mark my own interpretation separately.**Research question.** The authors ask whether LLMs can serve as agents in social simulation, and in which contexts this is defensible [p. 1; pp. 2-3]. The paper is a submission to JASSS [p. 1].**Main concepts.** The paper covers LLM psychological plausibility (Theory of Mind, emotion, bias, inconsistency) [pp. 3-5]. It also covers architectures (memory, reflection, planning, orchestration) [pp. 7-9], validation strategies [pp. 9-11], the "average persona" problem [p. 10; p. 14], and the loss of epistemic control over agent behavior [p. 15].**Methods and data.** The paper is a narrative literature review with no original experiments. It draws on reported results such as Turing-test rates of 56\% (LLaMa-3.1) and 73\% (GPT-4.5) [p. 2], and GPT-4 at over 75\% on Theory of Mind tasks [p. 4]. It surveys platforms including Generative Agents, AgentSociety (10,000+ agents), GenSim, AgentTorch, SALLMA and SocioVerse [pp. 6-7]. Evidence on those systems is secondhand.**Main findings (authors' claims).**- LLM social cognition is impressive but brittle, phrasing-sensitive, and described as probabilistic mimicry rather than understanding [p. 5].- Validation is immature. Generative Agents were assessed mainly for believability, not empirical correspondence [p. 6]. Problems include convergence to an "average persona", behavioral drift, and human raters overrating fluent output [pp. 10-11].- LLM use is most defensible for exploratory work, hypothesis generation, pilot studies, and interactive or serious-game settings [p. 12; p. 16], and for collective rather than individual patterns [p. 11].- The authors conclude that hybrid designs, with LLMs inside platforms such as GAMA or NetLogo, are the way forward [p. 17; p. 18].**Pros and cons for core ABM issues***Pros (paper's claims):*- Speed and scalability compared with human-subject studies [p. 12].- Unscripted emergent behavior [p. 12].- Natural-language specification of roles, and the ability to process institutional documents [pp. 12-13].- Context-sensitive behavior in established models, for example COMOKIT, where compliance and disinformation could be modeled richly [p. 13].- Ethical exploration of sensitive scenarios [p. 12].- Direct value in games and training [p. 16].*Cons (paper's claims):*- **Epistemic control.** The behavioral model becomes implicit in billions of parameters, so the modeler "relinquishes the ability to clearly define or justify the assumptions" [p. 15]. This is the paper's strongest point, and it supports your hypothesis.- **Explicability.** Black-box opacity makes verifying results "nearly impossible" [p. 13]. Agents' textual rationales do not remove this problem, since the authors state that chain-of-thought reasoning did not reliably reduce biases and sometimes amplified them [p. 5].- **Heterogeneity.** Homogenized agents weaken the study of phenomena that depend on diversity [p. 14].- **Reproducibility and sensitivity analysis.** Inconsistent outputs and high computational cost hinder classical sensitivity analysis and parameter sweeps [p. 15].- **Realism.** LLMs perform better in omniscient settings than under information asymmetry [p. 15].**Limitations (of the paper).**- It is a position paper with no new data.- The authors do not show that LLM agents improve understanding of collective outcomes. They themselves call LLMs "most defensible" only under narrow conditions [p. 11].- Several cited sources are preprints or non-peer-reviewed. Some references look inconsistent; for example, the Kosinski 2023 entry carries a title about failure on trivial alterations [p. 21], while the text uses it as evidence of success [p. 4].- Platform validation claims are reported without independent checking.**Relevance to the collection (interpretation, mine).** The paper largely supports your hypothesis. Its core objection, the loss of explicit, theory-justified behavioral assumptions, bears directly on your concerns about model construction, micro-level representation, and cumulative knowledge. Its own "pros" are mostly about convenience, scale and expressiveness, not improved explanation, and it offers no evidence of better insight into collective outcomes. As an LLM myself, I would still say that the hybrid proposal is sensible: delegate narrow, well-scoped decisions to a language model, keep rules and structure explicit, and treat results as exploratory. The paper's closing call for new methods to validate hybrid emergent behavior [p. 18] points to the open methodological work your collection addresses. The authors are also invested in the GAMA platform [p. 18; p. 22], which may color their advocacy of hybrids.Source DOI (verified metadata): 10.48550/arxiv.2507.19364Policy fingerprint: 297275f26e8e937bd8b1a395c3c7ebe88cdf4090447fc5000137546bc082f312; revision: 103246d2-13de-4b2c-b815-0d1654564fac; source fingerprint: 881e138835366633a0552a6f9168acd2519c4991acf641cb502092a547ebc771.},
	file = {Preprint PDF:/Users/kevinchapuis/Zotero/storage/PKVMRGGZ/Taillandier et al. - 2025 - Integrating LLM in Agent-Based Social Simulation Opportunities and Challenges.pdf:application/pdf},
}

@misc{piaoAgentSocietyLargeScaleSimulation2025,
	title = {{AgentSociety}: {Large}-{Scale} {Simulation} of {LLM}-{Driven} {Generative} {Agents} {Advances} {Understanding} of {Human} {Behaviors} and {Society}},
	shorttitle = {{AgentSociety}},
	url = {http://arxiv.org/abs/2502.08691},
	doi = {10.48550/arXiv.2502.08691},
	abstract = {Understanding human behavior and society is a central focus in social sciences, with the rise of generative social science marking a significant paradigmatic shift. By leveraging bottom-up simulations, it replaces costly and logistically challenging traditional experiments with scalable, replicable, and systematic computational approaches for studying complex social dynamics. Recent advances in large language models (LLMs) have further transformed this research paradigm, enabling the creation of human-like generative social agents and realistic simulacra of society. In this paper, we propose AgentSociety, a large-scale social simulator that integrates LLM-driven agents, a realistic societal environment, and a powerful large-scale simulation engine. Based on the proposed simulator, we generate social lives for over 10k agents, simulating their 5 million interactions both among agents and between agents and their environment. Furthermore, we explore the potential of AgentSociety as a testbed for computational social experiments, focusing on four key social issues: polarization, the spread of inflammatory messages, the effects of universal basic income policies, and the impact of external shocks such as hurricanes. These four issues serve as valuable cases for assessing AgentSociety's support for typical research methods -- such as surveys, interviews, and interventions -- as well as for investigating the patterns, causes, and underlying mechanisms of social issues. The alignment between AgentSociety's outcomes and real-world experimental results not only demonstrates its ability to capture human behaviors and their underlying mechanisms, but also underscores its potential as an important platform for social scientists and policymakers.},
	urldate = {2026-03-04},
	publisher = {arXiv},
	author = {Piao, Jinghua and Yan, Yuwei and Zhang, Jun and Li, Nian and Yan, Junbo and Lan, Xiaochong and Lu, Zhihong and Zheng, Zhiheng and Wang, Jing Yi and Zhou, Di and Gao, Chen and Xu, Fengli and Zhang, Fang and Rong, Ke and Su, Jun and Li, Yong},
	month = feb,
	year = {2025},
	note = {arXiv:2502.08691 [cs]},
	keywords = {Computer Science - Artificial Intelligence, Computer Science - Social and Information Networks},
	annote = {Auto-generated summary review, based on general default instructions with specific collection instructions (including approved ancestors where applicable). Verify against the original article; this is not a human-authored review.Zopilot summary reviewzotero-copilot:v1:user:199725:XPE6H43G:X2TVYRQYLength advisory: 690 words; the preferred range is 400-650 words. The full summary is preserved without truncation.Reference advisory: the generated text omitted the DOI. The verified source DOI is supplied separately below.**Summary: Piao et al., "AgentSociety" (arXiv 2502.08691)***Extraction note: all 45 PDF pages were available. Figures and tables were extracted imperfectly (Table 4 and Figures 16-23 are partly garbled), so I rely on the authors' text for results. The collection name in the template was not filled in, so I refer to your ABM methodology collection and its LLM-agents sub-section.***Research question.** The authors ask how far simulations can authentically replicate human society, given that rule-, equation- or ML-based agents behave unlike humans [pp. 2-3]. They propose LLM-driven agents in a realistic environment at large scale as the answer.**Main concepts.** The paper presents itself as "generative social science" and "a fourth paradigm" of computational social science [p. 37]. The agents combine Maslow's needs, the Theory of Planned Behavior, emotion and attitude scores, and stream memory [pp. 8-13]. Mobility uses a gravity model to limit LLM calls [pp. 9-10]. The environment is a separate layer of urban, social and economic modules that offloads numerical tasks because of LLM "hallucinations" [pp. 14-17].**Methods and data.** The engine uses Ray, asyncio and MQTT for distributed execution [pp. 17-21]. It was tested with DeepSeek-V3 [p. 23]. Four case studies follow:- Gun-control polarization [p. 30].- Inflammatory-message spread, based on the Xuzhou case with hundreds of agents [pp. 30-31].- A \$1,000/month UBI in a Texas-like population [p. 32].- Hurricane Dorian mobility with 1,000 agents, using SafeGraph and census data [p. 34].**Main findings (authors' claims).**- The system supports 10k agents averaging about 492 environment interactions per day [pp. 3, 28].- Messaging throughput was about 44,700 msg/s, against a stated need of 20,000 [p. 25].- Homophilic exposure left 52\% of agents more polarized, and opposing exposure moderated 89\% [p. 30].- Node-level intervention contained inflammatory content better than edge-level intervention [p. 31].- UBI raised consumption and lowered depression scores, which the authors call similar to Texas results [p. 32].- Simulated trips followed real hurricane trends, with "slight deviations" at the peak [p. 34].- The authors conclude that agents "accurately replicate" human behavior [p. 34].**Limitations (stated and observed).**- The authors state that the economic module omits labor and goods markets [p. 17].- They state that social behavior is mainly online [p. 11].- They state that LLM API latency is the main scaling bottleneck [p. 26].- Validation is largely qualitative and directional. In the extracted text I found no repeated runs, ablations, or comparison with a conventional ABM baseline (my observation, not an authors' statement).**Pros and cons for ABM (my interpretation, not the authors' claims).***Cons, which support your hypothesis:*- Mechanisms are not isolated. The agents bundle needs, emotion, memory, an LLM and environment rules, so a collective outcome cannot be traced to one assumption. The paper never tests this explicability question.- The authors' own validation criteria are matching direction and trend [pp. 32, 34]. That shows plausibility, not that the micro-mechanism is right. Different mechanisms could produce the same curve.- Agents' stated reasons (interviews, word clouds) [pp. 31-32] are generated text. They are not necessarily causal explanations.- The LLM is an opaque, non-reproducible, vendor-dependent component. The retry and JSON-parsing patches [p. 21] and the dependence on DeepSeek hint at fragility.- Cost and latency limit exploring a parameter space [p. 26].- Calling the system a "fourth paradigm" [p. 37] is a claim the evidence does not establish.*Pros:*- Natural-language interaction makes message-based phenomena such as persuasion and inflammatory content directly representable, which scalar opinion models cannot do [p. 2].- The engine makes surveys, interviews and interventions easy to run [pp. 22-23].- Separating the environment from the LLM is a sensible design that keeps numerical dynamics explicit [p. 14].- The infrastructure is a reusable contribution regardless of the agent-brain debate.**Relevance to the collection.** The paper is a clear example of the micro-model, LLM-as-decision-engine trend. It is useful as a case where scale and realism are asserted, while model explicability, accumulation of knowledge and epistemic status are largely unaddressed. As an LLM-based system I find the engineering impressive and the idea of linguistic agents promising. However, the evidence here supports your scepticism about understanding collective outcomes more than it refutes it.Source DOI (verified metadata): 10.48550/arxiv.2502.08691Policy fingerprint: 297275f26e8e937bd8b1a395c3c7ebe88cdf4090447fc5000137546bc082f312; revision: f87be5d1-37f3-4f22-b1e4-154d6c861353; source fingerprint: f02074ae77adee2d3ddd62d65114b75e67f0feeb3540e1276d634f203dff2505.},
	file = {Preprint PDF:/Users/kevinchapuis/Zotero/storage/S5Q6E72U/Piao et al. - 2025 - AgentSociety Large-Scale Simulation of LLM-Driven Generative Agents Advances Understanding of Human.pdf:application/pdf;Snapshot:/Users/kevinchapuis/Zotero/storage/MREHW93U/2502.html:text/html},
}


